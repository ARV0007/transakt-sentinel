# Copy to .env (./sentinel.sh does this for you). .env is gitignored — never commit it.

# --- The admin account Sentinel uses to read across merchants -------------------
# Created by `./sentinel.sh bootstrap` in your LOCAL Transakt only.
ADMIN_EMAIL=sentinel-admin@transakt.local
ADMIN_PASSWORD=change-me-sentinel

# --- Shared secret between investigator and transakt-mcp ------------------------
# transakt-mcp reads Transakt as an ADMIN, so it refuses requests without this.
# ./sentinel.sh fills it with a random value on first run.
MCP_TOKEN=

# --- A2A: lets OTHER agents ask Sentinel to investigate a payment --------------
# Callers send `Authorization: Bearer <A2A_TOKEN>` to POST /a2a. The agent card at
# /.well-known/agent-card.json is public. Empty = the A2A endpoint answers 503.
A2A_TOKEN=
PUBLIC_URL=http://localhost:8003

# --- LLM for the recommendation step (optional) ---------------------------------
# Leave LLM_API_KEY empty and the investigator writes recommendations from rules.
# Default provider: Hugging Face Inference Providers (OpenAI-compatible router).
# Get a token at https://huggingface.co/settings/tokens (a "read" token is enough).
LLM_API_KEY=
LLM_BASE_URL=https://router.huggingface.co/v1
# Any chat model your provider serves. Check the model's page on huggingface.co
# shows it is available through Inference Providers; change it if the call fails.
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF's free monthly credits run out quickly (the call then fails with 402 and rules take
# over). Groq's free tier is an alternative — key from https://console.groq.com/keys:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile

# --- Tracing (optional) ---------------------------------------------------------
# Free LangSmith account: https://smith.langchain.com — every case becomes a trace.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=transakt-sentinel

# --- Risk model from the Hugging Face Hub (optional) ----------------------------
# Leave empty to use the model trained into the image at build time.
# The file is skops (not pickle): types outside an allow-list are refused on load.
HF_MODEL_REPO=
RISK_THRESHOLD=0.5
